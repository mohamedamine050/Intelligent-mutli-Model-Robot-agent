Panels:
  - Class: rviz_common/Displays
    Name:  Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class:  rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation2
    Name: Navigation2

Visualization Manager:
  Class: ""
  Displays:
    # Grid
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: map
      Cell Size: 0.5
      Color:  160; 160; 164
      Enabled: true
      
    # Robot Model
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic: 
        Value: /robot_description
      Enabled: true
      
    # TF
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15. 0
      
    # LaserScan
    - Class:  rviz_default_plugins/LaserScan
      Name:  LaserScan
      Topic: 
        Value: /scan
      Size:  0.05
      Color: 255; 0; 0
      Enabled: true
      
    # Map
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic: 
        Value: /map
      Color Scheme: map
      Enabled: true
      
    # Local Costmap
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Value:  /local_costmap/costmap
      Color Scheme: costmap
      Enabled: true
      
    # Global Costmap
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Enabled: true
      
    # Global Plan
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
      Color:  0; 255; 0
      Enabled:  true
      
    # Local Plan
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
      Color: 255; 255; 0
      Enabled:  true
      
    # Camera Image (optional)
    - Class: rviz_default_plugins/Image
      Name: Camera Left
      Topic:
        Value:  /camera/left/image_raw
      Enabled: false

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
    
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
    - Class: nav2_rviz_plugins/GoalPose
      Topic:
        Value: /goal_pose
        
  Views:
    Current: 
      Class: rviz_default_plugins/Orbit
      Distance: 10. 0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.78
      Yaw: 0.78