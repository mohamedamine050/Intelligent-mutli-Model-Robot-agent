<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Reusable Wheel Macro
    Creates a wheel link and joint that can be used for left/right wheels
    
    Parameters:
      - prefix: "left" or "right"
      - parent: name of the parent link (usually "base_link")
      - x_offset: forward/backward position
      - y_offset: left/right position (positive = left side)
      - z_offset: height position
  -->

  <xacro:macro name="wheel" params="prefix parent x_offset y_offset z_offset">
    
    <!-- Wheel Link -->
    <link name="${prefix}_wheel_link">
      <!-- Visual representation -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.033" length="0.026"/>
        </geometry>
        <material name="wheel_${prefix}">
          <color rgba="0.2 0.2 0.2 1.0"/>  <!-- Dark gray -->
        </material>
      </visual>

      <!-- Collision geometry (same as visual) -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.033" length="0.026"/>
        </geometry>
      </collision>

      <!-- Inertial properties (important for simulation) -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>  <!-- 100 grams -->
        <inertia 
          ixx="0.00002708" ixy="0.0" ixz="0.0"
          iyy="0.00002708" iyz="0.0"
          izz="0.00005445"/>
      </inertial>
    </link>

    <!-- Wheel Joint (continuous rotation) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>  <!-- Rotates around Y-axis -->
      <limit effort="1.0" velocity="10.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Transmission for motor control (used by ros2_control) -->
    <transmission name="${prefix}_wheel_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_wheel_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_wheel_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

  </xacro:macro>

</robot>