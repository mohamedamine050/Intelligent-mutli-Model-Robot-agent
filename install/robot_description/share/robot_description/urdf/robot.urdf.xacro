<?xml version="1.0"?>
<robot name="navigation_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- INCLUDE MACROS -->
  <!-- ========================================== -->
  <xacro:include filename="$(find robot_description)/urdf/wheel.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/camera.xacro"/>

  <!-- ========================================== -->
  <!-- ROBOT PARAMETERS -->
  <!-- ========================================== -->
  <xacro:property name="base_width" value="0.16"/>      <!-- 16cm wide -->
  <xacro:property name="base_length" value="0.18"/>     <!-- 18cm long -->
  <xacro:property name="base_height" value="0.05"/>     <!-- 5cm tall -->
  <xacro:property name="base_mass" value="1.0"/>        <!-- 1kg -->
  
  <xacro:property name="wheel_radius" value="0.033"/>   <!-- 33mm radius -->
  <xacro:property name="wheel_width" value="0.026"/>    <!-- 26mm wide -->
  <xacro:property name="wheel_offset_x" value="0.0"/>   <!-- Center of robot -->
  <xacro:property name="wheel_offset_y" value="0.093"/>  <!-- Half width + wheel width -->
  <xacro:property name="wheel_offset_z" value="-0.0165"/> <!-- Ground clearance -->

  <xacro:property name="caster_radius" value="0.01"/>   <!-- 1cm caster ball -->

  <!-- ========================================== -->
  <!-- BASE FOOTPRINT (ground reference) -->
  <!-- ========================================== -->
  <link name="base_footprint">
    <!-- This is a virtual link at ground level, no visual/collision -->
  </link>

  <!-- ========================================== -->
  <!-- BASE LINK (main chassis) -->
  <!-- ========================================== -->
  <link name="base_link">
    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="robot_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>  <!-- Blue chassis -->
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <!-- Inertial -->
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia 
        ixx="${(1/12) * base_mass * (base_width*base_width + base_height*base_height)}"
        ixy="0.0" 
        ixz="0.0"
        iyy="${(1/12) * base_mass * (base_length*base_length + base_height*base_height)}"
        iyz="0.0"
        izz="${(1/12) * base_mass * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <!-- Joint connecting footprint to base_link -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- WHEELS (using macro) -->
  <!-- ========================================== -->
  <xacro:wheel 
    prefix="left" 
    parent="base_link"
    x_offset="${wheel_offset_x}"
    y_offset="${wheel_offset_y}"
    z_offset="${wheel_offset_z}"/>

  <xacro:wheel 
    prefix="right" 
    parent="base_link"
    x_offset="${wheel_offset_x}"
    y_offset="${-wheel_offset_y}"
    z_offset="${wheel_offset_z}"/>

  <!-- ========================================== -->
  <!-- CASTER WHEEL (for stability) -->
  <!-- ========================================== -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia 
        ixx="0.00001" ixy="0.0" ixz="0.0"
        iyy="0.00001" iyz="0.0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.07 0 -0.023" rpy="0 0 0"/>  <!-- Back of robot, near ground -->
  </joint>

  <!-- ========================================== -->
  <!-- CAMERA (using macro) -->
  <!-- ========================================== -->
  <xacro:oak_d_camera 
    parent="base_link"
    x="0.08"    
    y="0.0"     
    z="0.06"/> 
  <!-- ========================================== -->
  <!-- ULTRASONIC SENSOR -->
  <!-- ========================================== -->
  <link name="ultrasonic_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.020 0.015"/>  <!-- HC-SR04 dimensions -->
      </geometry>
      <material name="ultrasonic_blue">
        <color rgba="0.0 0.5 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.020 0.015"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia 
        ixx="0.00000001" ixy="0.0" ixz="0.0"
        iyy="0.00000001" iyz="0.0"
        izz="0.00000001"/>
    </inertial>
  </link>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.09 0 0.03" rpy="0 0 0"/>  <!-- Front center, below camera -->
  </joint>

  <!-- ========================================== -->
  <!-- GAZEBO MATERIALS (for simulation) -->
  <!-- ========================================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>  <!-- Friction coefficient -->
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/Grey</material>
    <mu1>0.1</mu1>  <!-- Low friction for caster -->
    <mu2>0.1</mu2>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="ultrasonic_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>